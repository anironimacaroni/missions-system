# העתק לקובץ .env (או הגדר ב-Vercel > Settings > Environment Variables)

# מחרוזת חיבור ל-Postgres
DATABASE_URL=

# מפתח OpenAI לסוכן
OPENAI_API_KEY=

# הסיסמה היחידה לכניסה למערכת
APP_PASSWORD=

# אופציונלי: שם המודל (ברירת מחדל: gpt-6-luna). תחילית "openai/" מתקבלת וגם מוסרת.
# OPENAI_MODEL=gpt-6-luna

# אופציונלי: כתובת בסיס אחרת ל-API תואם OpenAI (לבדיקות מקומיות)
# OPENAI_BASE_URL=
